{
  "expo": {
    "name": "Tabscape",
    "slug": "tabscape",
    "scheme": "tabscape",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14141c",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.heyjeay.tabscape",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Tabscape opens pages and shows site icons from servers on your own network, like a home server or a game server's panel."
      },
      "runtimeVersion": {
        "policy": "fingerprint"
      }
    },
    "android": {
      "package": "io.github.heyjeay.tabscape",
      "adaptiveIcon": {
        "backgroundColor": "#070a1f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "backgroundColor": "#14141c"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e0bef497-1c66-47fc-adb9-a62379977541"
      }
    },
    "owner": "heyjeay",
    "updates": {
      "url": "https://u.expo.dev/e0bef497-1c66-47fc-adb9-a62379977541"
    }
  }
}
