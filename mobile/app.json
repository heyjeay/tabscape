{
  "expo": {
    "name": "Tabscape",
    "slug": "tabscape",
    "scheme": "tabscape",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/app-icons/midnight.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14141c",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.heyjeay.tabscape",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Tabscape opens pages and shows site icons from servers on your own network, like a home server or a game server's panel."
      },
      "runtimeVersion": {
        "policy": "fingerprint"
      },
      "icon": "./assets/Tabscape.icon"
    },
    "android": {
      "package": "io.github.heyjeay.tabscape",
      "adaptiveIcon": {
        "backgroundColor": "#070a1f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "backgroundColor": "#14141c"
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Clear",
            "ios": {
              "light": "./assets/app-icons/clear.png",
              "dark": "./assets/app-icons/clear-dark.png",
              "tinted": "./assets/app-icons/clear-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/app-icons/clear.png",
              "backgroundColor": "#0b0f2a"
            }
          },
          {
            "name": "Aurora",
            "ios": {
              "light": "./assets/app-icons/aurora.png",
              "dark": "./assets/app-icons/aurora-dark.png",
              "tinted": "./assets/app-icons/aurora-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/app-icons/aurora.png",
              "backgroundColor": "#0b0f2a"
            }
          },
          {
            "name": "Gold",
            "ios": {
              "light": "./assets/app-icons/gold.png",
              "dark": "./assets/app-icons/gold-dark.png",
              "tinted": "./assets/app-icons/gold-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/app-icons/gold.png",
              "backgroundColor": "#0b0f2a"
            }
          },
          {
            "name": "Violet",
            "ios": {
              "light": "./assets/app-icons/tinted.png",
              "dark": "./assets/app-icons/tinted-dark.png",
              "tinted": "./assets/app-icons/tinted-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/app-icons/tinted.png",
              "backgroundColor": "#0b0f2a"
            }
          },
          {
            "name": "Layered",
            "ios": {
              "light": "./assets/app-icons/layered.png",
              "dark": "./assets/app-icons/layered-dark.png",
              "tinted": "./assets/app-icons/layered-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/app-icons/layered.png",
              "backgroundColor": "#0b0f2a"
            }
          },
          {
            "name": "Classic",
            "ios": "./assets/app-icons/classic.png",
            "android": {
              "foregroundImage": "./assets/app-icons/classic.png",
              "backgroundColor": "#0b0f2a"
            }
          }
        ]
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e0bef497-1c66-47fc-adb9-a62379977541"
      }
    },
    "owner": "heyjeay",
    "updates": {
      "url": "https://u.expo.dev/e0bef497-1c66-47fc-adb9-a62379977541"
    }
  }
}
