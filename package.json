{
  "name": "tabscape",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:extension": "vue-tsc --noEmit && vite build --mode extension",
    "dev:site": "vite --mode site",
    "build:site": "vue-tsc --noEmit && vite build --mode site",
    "build:firefox": "vue-tsc --noEmit && vite build --mode firefox"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "lucide-vue-next": "^0.475.0",
    "vue": "^3.5.25",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.332",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "simple-icons": "^15.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vue-tsc": "^2.1.10"
  },
  "license": "GPL-3.0-or-later",
  "description": "Say hello to productivity: your go-to sites one click away on every new tab, with zero clutter and seriously good looks.",
  "homepage": "https://heyjeay.github.io/tabscape/"
}
