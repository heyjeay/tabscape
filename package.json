{
  "name": "tabscape",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:extension": "vue-tsc --noEmit && vite build --mode extension",
    "dev:site": "vite --mode site",
    "build:site": "vue-tsc --noEmit && vite build --mode site",
    "build:firefox": "vue-tsc --noEmit && vite build --mode firefox"
  },
  "dependencies": {
