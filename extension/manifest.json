{
  "manifest_version": 3,
  "name": "Tabscape",
  "description": "Say hello to productivity: your go-to sites one click away on every new tab, with zero clutter and seriously good looks.",
  "version": "0.0.0",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "bookmarks",
    "favicon"
  ]
}
